APP_NAME="Dalil News"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# MySQL (hackathon laptops that already run MySQL):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dalil_news
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dalil News
# Drivers: fake (default, no keys) | whatsapp | telegram | openai
MESSAGING_DRIVER=fake
TRANSCRIPTION_DRIVER=fake
NORMALIZATION_DRIVER=fake
CLUSTERING_DRIVER=fake

# Meta WhatsApp Cloud API. Leave blank while MESSAGING_DRIVER=fake.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Digits only, country code, no plus. Used by the opt-in QR (wa.me).
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_GRAPH_VERSION=v21.0
# Never true in production. Empty app secret is rejected unless this is true.
WHATSAPP_SKIP_SIGNATURE=false
# Comma-separated numbers allowed to receive a dashboard test send.
WHATSAPP_TEST_RECIPIENTS=
# Morocco marketing / utility template rates, USD. Used only for the cost estimate.
WHATSAPP_MARKETING_USD=0.0414
WHATSAPP_UTILITY_USD=0.0230

# OpenAI. Used when TRANSCRIPTION_DRIVER, NORMALIZATION_DRIVER, or CLUSTERING_DRIVER is openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TRANSCRIBE_FALLBACK_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=90

# Optional Telegram fallback. Contacts created from this bot use the Telegram driver
# when MESSAGING_DRIVER is not fake.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SKIP_SECRET=false
